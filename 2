/* =====================================
LEVEL 1
DAILY ROUTINE
===================================== */

let routineOrder = [];

const routineCards =
document.querySelectorAll(".routine-card");

routineCards.forEach(card => {

card.addEventListener("click", () => {

```
const order =
  card.dataset.order;

if (routineOrder.includes(order)) {

  routineOrder =
    routineOrder.filter(
      item => item !== order
    );

  card.classList.remove("selected");

}

else {

  routineOrder.push(order);

  card.classList.add("selected");

}

updateRoutineDisplay();
```

});

});

function updateRoutineDisplay() {

const answerBox =
document.getElementById("routineAnswer");

answerBox.innerHTML = "";

routineOrder.forEach(number => {

```
const card =
  document.querySelector(
    `[data-order="${number}"]`
  );

const item =
  document.createElement("div");

item.className = "order-item";

item.textContent =
  card.querySelector("span").textContent;

answerBox.appendChild(item);
```

});

}

function checkRoutine() {

const correct =
["1","2","3","4","5","6"];

if (
JSON.stringify(routineOrder)
===
JSON.stringify(correct)
) {

```
updateScore(20);

addStar(3);

collectCrystal(1);

correctFeedback();

setTimeout(() => {

  startLevel(2);

}, 1800);
```

}

else {

```
wrongFeedback();
```

}

}

/* =====================================
GENERIC QUIZ LOADER
===================================== */

function loadQuestion(
questionData,
questionElement,
answersElement,
callback
) {

document
.getElementById(questionElement)
.innerHTML =
`<div class="question">
      ${questionData.question}     </div>`;

const answerContainer =
document.getElementById(answersElement);

answerContainer.innerHTML = "";

questionData.answers
.forEach(answer => {

```
  const button =
    document.createElement("button");

  button.className =
    "answer-btn";

  button.textContent =
    answer;

  button.addEventListener(
    "click",
    () => callback(
      answer,
      questionData.correct,
      button
    )
  );

  answerContainer.appendChild(button);

});
```

}

