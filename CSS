:root {
    --primary: #FF9800;
    --primary-hover: #F57C00;
    --secondary: #4CAF50;
    --secondary-hover: #388E3C;
    --text-dark: #333;
    --bg-glass: rgba(255, 255, 255, 0.9);
    --wrong: #F44336;
    --correct: #4CAF50;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: 'Nunito', sans-serif;
    user-select: none;
}

body {
    background-color: #2c3e50;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
}

/* 16:9 Responsive Game Container */
#game-container {
    width: 100%;
    max-width: 1024px;
    aspect-ratio: 16 / 9;
    background-color: #87CEEB;
    position: relative;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    border-radius: 15px;
}

/* Background Placeholders (Replace URLs with uploaded images) */
.bg-scene1 { background: url('scene1-bg.jpg') center/cover no-repeat, #87CEEB; }
.bg-scene2 { background: url('scene2-bg.jpg') center/cover no-repeat, #a2d149; }
.bg-level1 { background: url('level1-bg.jpg') center/cover no-repeat, #FFD54F; }
.bg-generic { background: url('generic-bg.jpg') center/cover no-repeat, #81D4FA; }
.bg-celebration { background: url('celebration-bg.jpg') center/cover no-repeat, #FF4081; }

.screen, .modal {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.hidden {
    display: none !important;
}

/* HUD System */
#hud {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    padding: 15px 25px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 100;
    font-size: 1.2rem;
    font-weight: 900;
    color: white;
    text-shadow: 2px 2px 0 #000, -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000, 1px 1px 0 #000;
}

.crystal { color: rgba(255, 255, 255, 0.5); font-size: 1.5rem; transition: color 0.3s; }
.crystal.filled { color: #00E5FF; text-shadow: 0 0 10px #00E5FF; }

/* Buttons & UI Elements */
.glass-panel {
    background: var(--bg-glass);
    padding: 30px;
    border-radius: 20px;
    text-align: center;
    box-shadow: 0 8px 32px rgba(0,0,0,0.2);
    border: 4px solid white;
    color: var(--text-dark);
    max-width: 80%;
}
.glass-panel.wide { max-width: 95%; }

h1 { font-size: 3rem; color: var(--primary); text-transform: uppercase; margin-bottom: 10px; }
h2 { font-size: 2rem; color: var(--secondary); margin-bottom: 15px; }
h3 { font-size: 1.5rem; margin-bottom: 20px; }
p { font-size: 1.2rem; margin-bottom: 15px; }

.primary-btn, .secondary-btn {
    padding: 15px 30px;
    font-size: 1.5rem;
    font-weight: 900;
    border: none;
    border-radius: 50px;
    cursor: pointer;
    margin: 10px;
    color: white;
    box-shadow: 0 6px 0 rgba(0,0,0,0.2);
    transition: transform 0.1s, box-shadow 0.1s;
}

.primary-btn { background-color: var(--primary); }
.primary-btn:active { background-color: var(--primary-hover); transform: translateY(6px); box-shadow: none; }
.secondary-btn { background-color: #2196F3; }
.secondary-btn:active { background-color: #1976D2; transform: translateY(6px); box-shadow: none; }

.icon-btn {
    font-size: 1.5rem;
    background: rgba(255,255,255,0.8);
    border: none;
    border-radius: 50%;
    width: 50px;
    height: 50px;
    cursor: pointer;
    box-shadow: 0 4px 0 rgba(0,0,0,0.2);
}
.icon-btn:active { transform: translateY(4px); box-shadow: none; }

.options-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
    margin-bottom: 20px;
}
.option-btn {
    background-color: #E1BEE7;
    border: 4px solid #9C27B0;
    color: var(--text-dark);
    font-size: 1.3rem;
    font-weight: bold;
    padding: 15px;
    border-radius: 15px;
    cursor: pointer;
    transition: transform 0.2s;
}
.option-btn:hover { transform: scale(1.05); }
.option-btn.correct { background-color: var(--correct); color: white; border-color: #1B5E20; }
.option-btn.wrong { background-color: var(--wrong); color: white; border-color: #B71C1C; }

/* Drag and Drop System */
.drag-drop-container {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 20px;
}
.drop-zones { display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; }
.drop-zone {
    width: 140px;
    height: 60px;
    border: 3px dashed #999;
    border-radius: 10px;
    display: flex;
    justify-content: center;
    align-items: center;
    background: rgba(255,255,255,0.5);
    font-weight: bold;
    position: relative;
}
.drop-zone::before { content: attr(data-number); position: absolute; top: -10px; left: -10px; background: var(--primary); color: white; border-radius: 50%; width: 25px; height: 25px; display: flex; justify-content: center; align-items: center; font-size: 0.9rem;}
.draggable-items { display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; min-height: 70px; }
.draggable {
    background-color: var(--primary);
    color: white;
    padding: 10px 15px;
    border-radius: 10px;
    cursor: grab;
    font-weight: bold;
    box-shadow: 0 4px 0 rgba(0,0,0,0.2);
}
.draggable:active { cursor: grabbing; }

/* Animations */
.bounce { animation: bounceIn 1s cubic-bezier(0.36, 0, 0.66, -0.56) forwards; }
.pulse { animation: pulse 2s infinite; }
#feedback-text { font-size: 2rem; font-weight: bold; margin: 10px 0; }
.text-correct { color: var(--correct); animation: bounceIn 0.5s; }
.text-wrong { color: var(--wrong); animation: shake 0.5s; }

/* Level 3 Animation specific */
#animation-layer {
    position: absolute; width: 100%; height: 100%; pointer-events: none; z-index: 50;
}
#football-char { position: absolute; bottom: 20%; left: 10%; font-size: 4rem; transition: left 1s; }
#goal-post { position: absolute; bottom: 20%; right: 10%; font-size: 5rem; }
.kick-anim #football-char { left: 75% !important; }

/* Modals */
.modal { background: rgba(0,0,0,0.7); z-index: 200; }
.stars { font-size: 3rem; margin: 10px 0; }

@keyframes bounceIn {
    0% { transform: scale(0.5); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
}
@keyframes pulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.05); }
    100% { transform: scale(1); }
}
@keyframes shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-10px); }
    50% { transform: translateX(10px); }
    75% { transform: translateX(-10px); }
}

/* Mobile adjustments */
@media (max-width: 768px) {
    h1 { font-size: 2rem; }
    .glass-panel { padding: 15px; }
    .primary-btn { font-size: 1.2rem; padding: 10px 20px; }
    .drop-zone { width: 100px; height: 50px; font-size: 0.8rem; }
    .draggable { font-size: 0.8rem; padding: 8px; }
}
